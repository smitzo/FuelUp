{
  "info": {
    "_postman_id": "4c35f54f-2d90-4ce8-b42b-f79e9257a9d1",
    "name": "FuelUp Route API v2",
    "description": "Market-configured route requests. The checked-in launch configuration is India; units and currency are declared in every successful response.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Plan configured-market route",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Declares market and units\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.api_version).to.equal(\"v2\");",
              "  pm.expect(body.market).to.include.keys(\"code\", \"currency_code\", \"distance_unit\", \"volume_unit\", \"efficiency_unit\");",
              "  pm.expect(body.route.distance).to.be.above(0);",
              "  pm.expect(body.fuel_plan.currency).to.equal(body.market.currency_code);",
              "});",
              "pm.test(\"Returns cache and request headers\", () => {",
              "  pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.ok;",
              "  pm.expect([\"HIT\", \"MISS\"]).to.include(pm.response.headers.get(\"X-FuelUp-Cache\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Request-ID",
            "value": "postman-market-route"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Ahmedabad, Gujarat\",\n  \"finish\": \"Vadodara, Gujarat\",\n  \"waypoints\": [\"Anand, Gujarat\"],\n  \"vehicle\": {\n    \"fuel_type\": \"petrol\",\n    \"tank_capacity\": 35,\n    \"efficiency\": 18,\n    \"starting_fuel\": 8,\n    \"reserve_fuel\": 3\n  },\n  \"maximum_detour\": 5,\n  \"strategy\": \"balanced\",\n  \"price_quality\": \"best_available\",\n  \"allow_stale_prices\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v2/route/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v2", "route", ""]
        }
      }
    },
    {
      "name": "2. Reject impossible vehicle reserve",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Returns typed validation error\", () => {",
              "  pm.expect(pm.response.json().error.code).to.equal(\"invalid_request\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Ahmedabad, Gujarat\",\n  \"finish\": \"Vadodara, Gujarat\",\n  \"vehicle\": {\n    \"fuel_type\": \"petrol\",\n    \"tank_capacity\": 35,\n    \"efficiency\": 18,\n    \"starting_fuel\": 34,\n    \"reserve_fuel\": 3\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v2/route/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v2", "route", ""]
        }
      }
    },
    {
      "name": "3. Require an active market catalogue",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Fails honestly when data is absent\", () => {",
              "  pm.expect([200, 422]).to.include(pm.response.code);",
              "  if (pm.response.code === 422) pm.expect(pm.response.json().error.code).to.equal(\"insufficient_price_data\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Mumbai, Maharashtra\",\n  \"finish\": \"Pune, Maharashtra\",\n  \"vehicle\": {\n    \"fuel_type\": \"diesel\",\n    \"tank_capacity\": 50,\n    \"efficiency\": 16,\n    \"starting_fuel\": 10,\n    \"reserve_fuel\": 5\n  },\n  \"price_quality\": \"station_reported_only\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v2/route/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v2", "route", ""]
        }
      }
    }
  ]
}
