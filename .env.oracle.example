API_DOMAIN=api.example.com
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
EXTERNAL_API_USER_AGENT=FuelUp/1.0 (contact: your-email@example.com)

ROUTE_CACHE_SECONDS=2592000
ROUTE_CACHE_LOCK_WAIT_SECONDS=15
WARM_COMMON_ROUTES=true
ROUTE_ALTERNATIVES=3
ROUTE_GEOMETRY_OVERVIEW=simplified
ROUTE_TIME_VALUE_USD_PER_HOUR=8
ROUTE_STOP_PENALTY_USD=4
ROUTE_RATE_LIMIT_REQUESTS=30
ROUTE_RATE_LIMIT_WINDOW_SECONDS=60

GUNICORN_WORKERS=3
GUNICORN_THREADS=2
LOG_LEVEL=INFO
RELEASE_SHA=oracle
