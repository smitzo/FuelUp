DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
DATABASE_CONN_MAX_AGE=60
REDIS_URL=
EXTERNAL_API_USER_AGENT=FuelUpRouteExercise/1.0 (contact: your-email@example.com)
EXTERNAL_API_TIMEOUT_SECONDS=8
GEOCODE_CACHE_SECONDS=86400
ROUTE_CACHE_SECONDS=3600
ROUTE_ALTERNATIVES=3
ROUTE_TIME_VALUE_USD_PER_HOUR=8
ROUTE_STOP_PENALTY_USD=4
CACHE_DIR=/tmp/fuelup-cache
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
ROUTING_BASE_URL=https://router.project-osrm.org
