DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
DATABASE_CONN_MAX_AGE=60
REDIS_URL=
EXTERNAL_API_USER_AGENT=FuelUpRouteExercise/1.0 (contact: your-email@example.com)
EXTERNAL_API_TIMEOUT_SECONDS=8
GEOCODE_CACHE_SECONDS=86400
ROUTE_CACHE_SECONDS=2592000
ROUTE_CACHE_LOCK_WAIT_SECONDS=15
WARM_COMMON_ROUTES=false
ROUTE_ALTERNATIVES=3
ROUTE_GEOMETRY_OVERVIEW=simplified
ROUTE_TIME_VALUE_USD_PER_HOUR=8
ROUTE_STOP_PENALTY_USD=4
ROUTE_RATE_LIMIT_REQUESTS=30
ROUTE_RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=false
LOG_LEVEL=INFO
RELEASE_SHA=development
SECURE_SSL_REDIRECT=true
CACHE_DIR=/tmp/fuelup-cache
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
ROUTING_BASE_URL=https://router.project-osrm.org

# Backend-only credentials. Never add actual keys to this example.
API_MITRA_API_KEY=
HEIGIT_API_KEY=
PRICE_SOURCE_SLUG=api-mitra-fuel
# Keep at zero until the provider's actual free production quota is confirmed.
API_MITRA_MONTHLY_LIMIT=0
API_MITRA_DAILY_LIMIT=2
HEIGIT_MONTHLY_LIMIT=1500
HEIGIT_DAILY_LIMIT=100
# Enable only after the source registry has recorded the provider review.
# ROUTING_SOURCE_SLUG=heigit-openrouteservice
